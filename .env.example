NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=
# Required only for an isolated Preview; never use the working project reference.
PREVIEW_SUPABASE_PROJECT_REF=

# HR-21: server only, Production/local operator environment. Never copy to Preview.
# See docs/supabase-server-configuration-2026-11-15.ru.md before enabling/probing.
SUPABASE_SECRET_KEY=

# Server only. Never prefix the AI key with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Enable only after verifying an active credit grant and auto-reload OFF.
CAREER_AI_CREDITS_ONLY=false
# ISO timestamp: stop at the verified grant expiry; recheck renewal before extending.
CAREER_AI_CREDITS_VALID_UNTIL=
